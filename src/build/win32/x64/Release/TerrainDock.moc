bool TerrainDock::qt_emit( int _id, QUObject* _o )
{
    switch ( _id - staticMetaObject()->signalOffset() ) {
    case 0: terrainGameWindowStatusChanged(); break;
    default:
	return BaseTerrainDock::qt_emit(_id,_o);
    }
    return TRUE;
}
