void* TerrainDock::qt_cast( const char* clname )
{
    if ( !qstrcmp( clname, "TerrainDock" ) )
	return this;
    if ( !qstrcmp( clname, "MessageDispatch::Receiver" ) )
	return (MessageDispatch::Receiver*)this;
    return BaseTerrainDock::qt_cast( clname );
}

