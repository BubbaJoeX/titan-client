                                    <widget class="QLabel">
                                        <property name="name">
                                            <cstring>m_bitmapRotationLabel</cstring>
                                        </property>
                                        <property name="text">
                                            <string>Rotation:</string>
                                        </property>
                                    </widget>
                                    <widget class="QSlider">
                                        <property name="name">
                                            <cstring>m_bitmapRotationSlider</cstring>
                                        </property>
                                        <property name="minValue">
                                            <number>0</number>
                                        </property>
                                        <property name="maxValue">
                                            <number>360</number>
                                        </property>
                                        <property name="value">
                                            <number>0</number>
                                        </property>
                                        <property name="orientation">
                                            <enum>Horizontal</enum>
                                        </property>
                                    </widget>
                                    <widget class="QLabel">
                                        <property name="name">
                                            <cstring>m_bitmapRotationValue</cstring>
                                        </property>
                                        <property name="text">
                                            <string>0°</string>
                                        </property>
                                    </widget>
                                </hbox>
                            </widget>
                            <widget class="QLayoutWidget">
                                <property name="name">
                                    <cstring>m_bitmapScaleLayout</cstring>
                                </property>
                                <hbox>
                                    <widget class="QLabel">
                                        <property name="name">
                                            <cstring>m_bitmapScaleLabel</cstring>
                                        </property>
                                        <property name="text">
                                            <string>Scale:</string>
                                        </property>
                                    </widget>
                                    <widget class="QSlider">
                                        <property name="name">
                                            <cstring>m_bitmapScaleSlider</cstring>
                                        </property>
                                        <property name="minValue">
                                            <number>10</number>
                                        </property>
                                        <property name="maxValue">
                                            <number>500</number>
                                        </property>
                                        <property name="value">
                                            <number>100</number>
                                        </property>
                                        <property name="orientation">
                                            <enum>Horizontal</enum>
                                        </property>
                                    </widget>
                                    <widget class="QLabel">
                                        <property name="name">
                                            <cstring>m_bitmapScaleValue</cstring>
                                        </property>
                                        <property name="text">
                                            <string>100%</string>
                                        </property>
                                    </widget>
                                </hbox>
                            </widget>
                            <widget class="QCheckBox">
                                <property name="name">
                                    <cstring>m_bitmapAffectsHeightCheck</cstring>
                                </property>
                                <property name="text">
                                    <string>Affects Height</string>
                                </property>
                                <property name="checked">
                                    <bool>true</bool>
                                </property>
                            </widget>
                            <widget class="QCheckBox">
                                <property name="name">
                                    <cstring>m_bitmapAffectsShaderCheck</cstring>
                                </property>
                                <property name="text">
                                    <string>Affects Shader</string>
                                </property>
                            </widget>
                        </vbox>
                    </widget>
                    <spacer>
                        <property name="name">
                            <cstring>m_advancedSpacer</cstring>
                        </property>
                        <property name="orientation">
                            <enum>Vertical</enum>
                        </property>
                        <property name="sizeType">
                            <enum>Expanding</enum>
                        </property>
                    </spacer>
                </vbox>
            </widget>
            <widget class="QWidget">
                <property name="name">
                    <cstring>m_layersTab</cstring>
                </property>
                <attribute name="title">
                    <string>Layers</string>
                </attribute>
                <vbox>
                    <property name="margin">
                        <number>6</number>
                    </property>
                    <property name="spacing">
                        <number>4</number>
                    </property>
                    <widget class="QListView">
                        <property name="name">
                            <cstring>m_layerList</cstring>
                        </property>
                        <column>
                            <property name="text">
                                <string>Layer</string>
                            </property>
                            <property name="clickable">
                                <bool>true</bool>
                            </property>
                            <property name="resizable">
                                <bool>true</bool>
                            </property>
                        </column>
                        <column>
                            <property name="text">
                                <string>Type</string>
                            </property>
                            <property name="clickable">
                                <bool>true</bool>
                            </property>
                            <property name="resizable">
                                <bool>true</bool>
                            </property>
                        </column>
                        <column>
                            <property name="text">
                                <string>Active</string>
                            </property>
                            <property name="clickable">
                                <bool>true</bool>
                            </property>
                            <property name="resizable">
                                <bool>true</bool>
                            </property>
                        </column>
                        <property name="selectionMode">
                            <enum>Single</enum>
                        </property>
                    </widget>
                </vbox>
            </widget>
        </widget>
        <widget class="QGroupBox">
            <property name="name">
                <cstring>m_visualGroup</cstring>
            </property>
            <property name="title">
                <string>Visualization</string>
            </property>
            <grid>
                <property name="margin">
                    <number>6</number>
                </property>
                <property name="spacing">
                    <number>4</number>
                </property>
                <widget class="QCheckBox" row="0" column="0">
                    <property name="name">
                        <cstring>m_wireframeCheck</cstring>
                    </property>
                    <property name="text">
                        <string>Wireframe Overlay</string>
                    </property>
                </widget>
                <widget class="QCheckBox" row="0" column="1">
                    <property name="name">
                        <cstring>m_heightColorsCheck</cstring>
                    </property>
                    <property name="text">
                        <string>Height Colors</string>
                    </property>
                </widget>
                <widget class="QCheckBox" row="1" column="0">
                    <property name="name">
                        <cstring>m_chunkGridCheck</cstring>
                    </property>
                    <property name="text">
                        <string>Chunk Grid</string>
                    </property>
                </widget>
                <widget class="QCheckBox" row="1" column="1">
                    <property name="name">
                        <cstring>m_brushPreviewCheck</cstring>
                    </property>
                    <property name="text">
                        <string>Brush Preview</string>
                    </property>
                    <property name="checked">
                        <bool>true</bool>
                    </property>
                </widget>
            </grid>
        </widget>
        <widget class="QGroupBox">
            <property name="name">
                <cstring>m_regionGroup</cstring>
            </property>
            <property name="title">
                <string>Region Operations</string>
            </property>
            <hbox>
                <property name="margin">
                    <number>6</number>
                </property>
                <property name="spacing">
                    <number>4</number>
                </property>
                <widget class="QPushButton">
                    <property name="name">
                        <cstring>m_selectRegionButton</cstring>
                    </property>
                    <property name="text">
                        <string>Select</string>
                    </property>
                    <property name="toggleButton">
                        <bool>true</bool>
                    </property>
                </widget>
                <widget class="QPushButton">
                    <property name="name">
                        <cstring>m_copyRegionButton</cstring>
                    </property>
                    <property name="text">
                        <string>Copy</string>
                    </property>
                </widget>
                <widget class="QPushButton">
                    <property name="name">
                        <cstring>m_pasteRegionButton</cstring>
                    </property>
                    <property name="text">
                        <string>Paste</string>
                    </property>
                </widget>
                <widget class="QPushButton">
                    <property name="name">
                        <cstring>m_fillRegionButton</cstring>
                    </property>
                    <property name="text">
                        <string>Fill</string>
                    </property>
                </widget>
            </hbox>
        </widget>
        <widget class="QGroupBox">
            <property name="name">
                <cstring>m_undoGroup</cstring>
            </property>
            <property name="title">
                <string>History</string>
            </property>
            <hbox>
                <property name="margin">
                    <number>6</number>
                </property>
                <property name="spacing">
                    <number>4</number>
                </property>
                <widget class="QPushButton">
                    <property name="name">
                        <cstring>m_undoButton</cstring>
                    </property>
                    <property name="text">
                        <string>Undo</string>
                    </property>
                    <property name="enabled">
                        <bool>false</bool>
                    </property>
                </widget>
                <widget class="QPushButton">
                    <property name="name">
                        <cstring>m_redoButton</cstring>
                    </property>
                    <property name="text">
                        <string>Redo</string>
                    </property>
                    <property name="enabled">
                        <bool>false</bool>
                    </property>
                </widget>
                <widget class="QPushButton">
                    <property name="name">
                        <cstring>m_clearHistoryButton</cstring>
                    </property>
                    <property name="text">
                        <string>Clear History</string>
                    </property>
                </widget>
            </hbox>
        </widget>
        
    </vbox>
</widget>
<customwidgets>
</customwidgets>
<layoutdefaults spacing="6" margin="11"/>
</UI>
