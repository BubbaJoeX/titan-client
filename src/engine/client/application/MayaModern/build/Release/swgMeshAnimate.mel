// SwgMayaEditor — attributes for animated texture / SWTS static mesh export.
// Requires: loadPlugin SwgMayaEditor;
//
// ExportStaticMesh looks for:
//   - mesh transform: swgMeshAnimate (bool marker; optional visual tag for artists / future tooling)
//   - file texture: useFrameExtension = on; all frames in the **same folder** as the resolved path, naming:
//       stem.1234.ext OR stem1234.ext (any stem / ext; export sorts by frame index for SWTS / viewer)
//       swgAnimFpsMin, swgAnimFpsMax, swgAnimOrder  (or legacy soe_animating*)
//
// Quick setup from selected mesh(es) or transform(s):
//   swgSetupMeshAnimatedTextureExport 8 8 0;
//   // args: fpsMin fpsMax orderEnum   (0=Looping, 1=PingPong, 2=Random)
//
// Tag mesh transform only:
//   swgAddSwgMeshAnimateOnSelected 1;
//
// Tag selected file texture node(s) only:
//   swgAddSwgAnimTextureAttrsOnSelected 8 8 0;

/// Mesh shape(s) or transform(s) under selection -> parent transform paths (long names).
global proc string[] swgMeshAnimateResolveTransformsFromSelection()
{
    string $out[];
    string $sel[] = `ls -sl`;
    if (size($sel) < 1)
        return $out;

    string $n;
    for ($n in $sel)
    {
        string $t = `nodeType $n`;
        if ($t == "transform")
        {
            $out[size($out)] = $n;
            continue;
        }
        if ($t == "mesh")
        {
            string $p[] = `listRelatives -f -parent $n`;
            if (size($p) > 0)
                $out[size($out)] = $p[0];
            continue;
        }
    }

    // Dedupe
    string $dedup[];
    string $x;
    for ($x in $out)
    {
        int $have = 0;
        string $y;
        for ($y in $dedup)
        {
            if ($y == $x)
            {
                $have = 1;
                break;
            }
        }
        if (!$have)
            $dedup[size($dedup)] = $x;
    }
    return $dedup;
}

/// file nodes driving common diffuse-like inputs on a surface shader.
global proc string[] swgMeshAnimateListFileTexturesFromSurfaceShader(string $shader)
{
    string $files[];
    string $attrs[] = {"baseColor", "color", "diffuseColor", "diffuse", "emissionColor", "emission_color", "incandescence", "TEX_color"};
    string $a;
    for ($a in $attrs)
    {
        if (!`attributeExists $a $shader`)
            continue;
        string $src[] = `listConnections -source true -destination false ($shader + "." + $a)`;
        string $node;
        for ($node in $src)
        {
            if (`nodeType $node` == "file")
            {
                int $dup = 0;
                string $f;
                for ($f in $files)
                {
                    if ($f == $node)
                    {
                        $dup = 1;
                        break;
                    }
                }
                if (!$dup)
                    $files[size($files)] = $node;
            }
        }
    }
    return $files;
}

/// Shading engines assigned to mesh shape $meshShape.
global proc string[] swgMeshAnimateShadingEnginesForMeshShape(string $meshShape)
{
    string $sg[] = `listConnections -type "shadingEngine" $meshShape`;
    return $sg;
}

global proc swgAddSwgMeshAnimateOnSelected(int $value)
{
    string $xf[] = `swgMeshAnimateResolveTransformsFromSelection`;
    if (size($xf) < 1)
    {
        warning "swgAddSwgMeshAnimateOnSelected: select mesh transform(s) or mesh shape(s).";
        return;
    }
    string $x;
    for ($x in $xf)
    {
        if (!`attributeExists "swgMeshAnimate" $x`)
            addAttr -ln "swgMeshAnimate" -nn "SWG Mesh Animate" -at bool -dv $value -k true $x;
        else
            setAttr ($x + ".swgMeshAnimate") $value;
    }
}

/// Add swgAnim* on file node $fileNode (and optional useFrameExtension).
global proc swgMeshAnimateAddAttrsOnFileNode(string $fileNode, float $fpsMin, float $fpsMax, int $orderEnum)
{
    string $t = `nodeType $fileNode`;
    if ($t != "file")
    {
        warning ("swgMeshAnimateAddAttrsOnFileNode: not a file node: " + $fileNode);
        return;
    }

    if (!`attributeExists "useFrameExtension" $fileNode`)
    {
        warning ("swgMeshAnimateAddAttrsOnFileNode: useFrameExtension missing (unexpected for file node): " + $fileNode);
    }
    else
        setAttr ($fileNode + ".useFrameExtension") 1;

    if (!`attributeExists "swgAnimFpsMin" $fileNode`)
        addAttr -ln "swgAnimFpsMin" -nn "SWG Anim FPS Min" -at double -dv $fpsMin -min 0.0001 -k true $fileNode;
    else
        setAttr ($fileNode + ".swgAnimFpsMin") $fpsMin;

    if (!`attributeExists "swgAnimFpsMax" $fileNode`)
        addAttr -ln "swgAnimFpsMax" -nn "SWG Anim FPS Max" -at double -dv $fpsMax -min 0.0001 -k true $fileNode;
    else
        setAttr ($fileNode + ".swgAnimFpsMax") $fpsMax;

    if (!`attributeExists "swgAnimOrder" $fileNode`)
        addAttr -ln "swgAnimOrder" -nn "SWG Anim Order" -at "enum" -en "Looping:PingPong:Random:" -dv 0 -k true $fileNode;
    setAttr ($fileNode + ".swgAnimOrder") $orderEnum;
}

/// Selected objects: any mix of file textures, mesh shapes, or transforms (meshes -> all SG file textures).
global proc swgAddSwgAnimTextureAttrsOnSelected(float $fpsMin, float $fpsMax, int $orderEnum)
{
    string $sel[] = `ls -sl`;
    if (size($sel) < 1)
    {
        warning "swgAddSwgAnimTextureAttrsOnSelected: select file texture(s), mesh shape(s), or transform(s).";
        return;
    }

    string $fileNodes[];

    string $n;
    for ($n in $sel)
    {
        string $t = `nodeType $n`;
        if ($t == "file")
        {
            $fileNodes[size($fileNodes)] = $n;
            continue;
        }

        string $meshes[];
        if ($t == "mesh")
            $meshes[size($meshes)] = $n;
        else if ($t == "transform")
        {
            string $sh[] = `listRelatives -f -path -s $n`;
            string $s;
            for ($s in $sh)
            {
                if (`nodeType $s` == "mesh")
                    $meshes[size($meshes)] = $s;
            }
        }

        string $m;
        for ($m in $meshes)
        {
            string $sgs[] = `swgMeshAnimateShadingEnginesForMeshShape $m`;
            string $sg;
            for ($sg in $sgs)
            {
                string $surf[] = `listConnections ($sg + ".surfaceShader")`;
                if (size($surf) < 1)
                    continue;
                string $shad = $surf[0];
                string $ff[] = `swgMeshAnimateListFileTexturesFromSurfaceShader $shad`;
                string $f;
                for ($f in $ff)
                {
                    int $dup = 0;
                    string $e;
                    for ($e in $fileNodes)
                    {
                        if ($e == $f)
                        {
                            $dup = 1;
                            break;
                        }
                    }
                    if (!$dup)
                        $fileNodes[size($fileNodes)] = $f;
                }
            }
        }
    }

    if (size($fileNodes) < 1)
    {
        warning "swgAddSwgAnimTextureAttrsOnSelected: no file texture nodes found from selection.";
        return;
    }

    string $fn;
    for ($fn in $fileNodes)
        swgMeshAnimateAddAttrsOnFileNode($fn, $fpsMin, $fpsMax, $orderEnum);

    print "// SwgMayaEditor: swgAnim* + useFrameExtension on selected file texture chain(s).\n";
}

/// One step: mark mesh transform(s) + configure file texture(s) for SWTS export.
global proc swgSetupMeshAnimatedTextureExport(float $fpsMin, float $fpsMax, int $orderEnum)
{
    swgAddSwgMeshAnimateOnSelected 1;
    swgAddSwgAnimTextureAttrsOnSelected $fpsMin $fpsMax $orderEnum;
}
