// swgKeepFrameZeroKeys.mel - Strip animation keys except those at frame 0.
//
// Usage:
//   Select any root(s) of the rig (one joint, a group above the skeleton, etc.). All descendant
//   transforms (joints, groups, IK, etc.) are included — you do not need to Select Hierarchy first.
//     swgKeepFrameZeroKeys;              // integer timeline: keeps keys on frame 0 only
//     swgKeepFrameZeroKeysStrict;        // strict: keeps only keys within +/- 0.00001 of time 0
//
// Default mode removes keys at time >= 1 and time <= -1, so sub-frame keys between 0 and 1 remain.
// Strict mode removes everything outside an epsilon around t=0.

global proc swgKeepFrameZeroKeysImpl(int $strict)
{
    if (size(`ls -sl`) == 0)
    {
        warning "swgKeepFrameZeroKeys: Select one or more nodes (e.g. root joint or rig group).";
        return;
    }

    // All transforms under selection (recursive). Joints and intermediate groups are included.
    string $targets[] = `ls -dag -sl -fullPath -type transform`;
    if (size($targets) == 0)
    {
        warning "swgKeepFrameZeroKeys: No transform nodes under selection.";
        return;
    }

    if ($strict)
    {
        cutKey -clear -time "0.00001:" $targets;
        cutKey -clear -time ":-0.00001" $targets;
    }
    else
    {
        cutKey -clear -time "1:" $targets;
        cutKey -clear -time ":-1" $targets;
    }

    print "swgKeepFrameZeroKeys: removed keys except near frame 0 on ";
    print size($targets);
    print " node(s) (strict=";
    print $strict;
    print ").\n";
}

global proc swgKeepFrameZeroKeys()
{
    swgKeepFrameZeroKeysImpl(0);
}

global proc swgKeepFrameZeroKeysStrict()
{
    swgKeepFrameZeroKeysImpl(1);
}
