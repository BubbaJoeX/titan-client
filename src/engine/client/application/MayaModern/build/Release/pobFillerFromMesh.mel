// SwgMayaEditor — Build a 1-cell .pob authoring rig from a “filler” exterior mesh in Maya.
//
// Game export still uses external_reference strings on r0|mesh and r0|collision|floor0 (Tree paths, no extension).
// Geometry parented under r0|mesh is for layout / portal placement only (same as pobAuthoring placeholders).
//
// Prereq: loadPlugin SwgMayaEditor    (source pobAuthoring.mel optional — this file is self-contained for refs)
//
//   swg_pob_fillerSetRefs "|pob_root" "appearance/foo/building" "appearance/foo/building";
//   swg_pob_fillerParentSelectionUnderMesh "|pob_root";   // duplicate selection under r0|mesh
//   swg_pob_fillerFitPortalsFromRoomMesh "|pob_root" 1 2.0 2.5;   // 1 or 2 exits, door W/H
//
// One-shot (selection = exterior transform, paths without file extension):
//   swg_pob_fillerFromExteriorSelection "my_filler" "appearance/house/filler_a" "" 2 2.0 2.5 1;
//       last args: numExits(1|2), doorW, doorH, addLights (floor path "" → same as mesh path)

global proc swg_pob_fillerSetRefs(string $rootLong, string $meshPath, string $floorPath)
{
    if (size($floorPath) < 1)
        $floorPath = $meshPath;
    string $mesh = $rootLong + "|r0|mesh";
    string $fl = $rootLong + "|r0|collision|floor0";
    if (`objExists $mesh` && size($meshPath) > 0)
        setAttr -type "string" ($mesh + ".external_reference") $meshPath;
    if (`objExists $fl` && size($floorPath) > 0)
        setAttr -type "string" ($fl + ".external_reference") $floorPath;
    print ("// swg_pob_fillerSetRefs: mesh + floor external_reference set\n");
}

/// Duplicate selected transforms (not already under this POB) under r0|mesh for bbox / layout.
global proc swg_pob_fillerParentSelectionUnderMesh(string $rootName)
{
    string $sel[] = `ls -sl -typ transform`;
    if (size($sel) < 1)
    {
        warning "swg_pob_fillerParentSelectionUnderMesh: select one or more exterior transforms";
        return;
    }
    string $rl[] = `ls -long $rootName`;
    if (size($rl) < 1)
    {
        warning "swg_pob_fillerParentSelectionUnderMesh: bad POB root";
        return;
    }
    string $base = $rl[0];
    string $meshParent = $base + "|r0|mesh";
    if (!`objExists $meshParent`) return;

    string $o;
    for ($o in $sel)
    {
        string $ol[] = `ls -long $o`;
        if (size($ol) < 1) continue;
        string $longO = $ol[0];
        if (`gmatch $longO ($base + "|*")`)
            continue;
        string $d[] = `duplicate -rr $longO`;
        if (size($d) > 0)
            parent $d[0] $meshParent;
    }
    print "// swg_pob_fillerParentSelectionUnderMesh: duplicates parented under r0|mesh\n";
}

global proc float[] swg_pob_fillerWorldBBoxUnionUnderMesh(string $meshGrpLong)
{
    float $out[6];
    $out[0] = 1.0e20;
    $out[1] = 1.0e20;
    $out[2] = 1.0e20;
    $out[3] = -1.0e20;
    $out[4] = -1.0e20;
    $out[5] = -1.0e20;

    string $ad[] = `listRelatives -ad -path $meshGrpLong`;
    if (size($ad) < 1)
        return $out;

    int $any = 0;
    string $p;
    for ($p in $ad)
    {
        if (`nodeType $p` != "mesh")
            continue;
        float $b[] = `xform -q -ws -boundingBox $p`;
        if (size($b) < 6)
            continue;
        if ($b[0] < $out[0]) $out[0] = $b[0];
        if ($b[1] < $out[1]) $out[1] = $b[1];
        if ($b[2] < $out[2]) $out[2] = $b[2];
        if ($b[3] > $out[3]) $out[3] = $b[3];
        if ($b[4] > $out[4]) $out[4] = $b[4];
        if ($b[5] > $out[5]) $out[5] = $b[5];
        $any++;
    }

    if ($any == 0)
    {
        // Sentinel: min > max so caller can detect "no geometry"
        $out[0] = 1.0;
        $out[1] = 1.0;
        $out[2] = 1.0;
        $out[3] = 0.0;
        $out[4] = 0.0;
        $out[5] = 0.0;
    }
    return $out;
}

/// Move $childTransform to the position that is ($wx,$wy,$wz) in world space, expressed as local translate under $parentPath.
global proc swg_pob_fillerMoveToWorldPos(string $childTransform, string $parentPath, float $wx, float $wy, float $wz)
{
    string $lc[] = `spaceLocator`;
    if (size($lc) < 1) return;
    string $loc = $lc[0];
    move -ws $wx $wy $wz $loc;
    parent $loc $parentPath;
    float $tx = `getAttr ($loc + ".tx")`;
    float $ty = `getAttr ($loc + ".ty")`;
    float $tz = `getAttr ($loc + ".tz")`;
    delete $loc;
    xform -os -t $tx $ty $tz $childTransform;
}

/// Delete all portal transforms under r0|portals for this POB.
global proc swg_pob_fillerClearPortals(string $rootName)
{
    string $rl[] = `ls -long $rootName`;
    if (size($rl) < 1) return;
    string $portals = $rl[0] + "|r0|portals";
    if (!`objExists $portals`) return;
    string $kids[] = `listRelatives -c -typ transform $portals`;
    for ($k in $kids)
        delete $k;
}

/// Place 1 portal on the min-Z face or 2 portals on min-Z and max-Z faces (world space), door bases at min Y.
global proc swg_pob_fillerFitPortalsFromRoomMesh(string $rootName, int $numExits, float $doorW, float $doorH)
{
    if (`pluginInfo -q -loaded SwgMayaEditor` != 1)
        loadPlugin SwgMayaEditor;

    if ($numExits != 1 && $numExits != 2)
    {
        warning "swg_pob_fillerFitPortalsFromRoomMesh: numExits must be 1 or 2";
        return;
    }
    if ($doorW <= 0 || $doorH <= 0)
    {
        warning "swg_pob_fillerFitPortalsFromRoomMesh: door W/H must be > 0";
        return;
    }

    string $rl[] = `ls -long $rootName`;
    if (size($rl) < 1)
    {
        warning "swg_pob_fillerFitPortalsFromRoomMesh: could not resolve root";
        return;
    }
    string $base = $rl[0];
    string $meshGrp = $base + "|r0|mesh";
    string $portalsPath = $base + "|r0|portals";
    if (!`objExists $meshGrp` || !`objExists $portalsPath`) return;

    float $bb[] = `swg_pob_fillerWorldBBoxUnionUnderMesh $meshGrp`;
    if ($bb[0] > $bb[3])
    {
        warning "swg_pob_fillerFitPortalsFromRoomMesh: no mesh shapes under r0|mesh — parent exterior geo first";
        return;
    }

    swg_pob_fillerClearPortals($rootName);

    float $cx = ($bb[0] + $bb[3]) * 0.5;
    float $y0 = $bb[1];
    float $zn = $bb[2];
    float $zp = $bb[5];

    if ($numExits == 1)
    {
        string $cmd = "addPobPortal -parent \"" + $portalsPath + "\" -n filler_exit_0 -index 0 -clockwise 0 -target -1 -w "
            + $doorW + " -h " + $doorH;
        eval $cmd;
        string $p[] = `ls -long ($portalsPath + "|filler_exit_0")`;
        if (size($p) > 0)
            swg_pob_fillerMoveToWorldPos($p[0], $portalsPath, $cx, $y0, $zn);
    }
    else
    {
        string $cmd1 = "addPobPortal -parent \"" + $portalsPath + "\" -n filler_exit_0 -index 0 -clockwise 0 -target -1 -w "
            + $doorW + " -h " + $doorH;
        eval $cmd1;
        string $cmd2 = "addPobPortal -parent \"" + $portalsPath + "\" -n filler_exit_1 -index 1 -clockwise 1 -target -1 -w "
            + $doorW + " -h " + $doorH;
        eval $cmd2;
        string $p0[] = `ls -long ($portalsPath + "|filler_exit_0")`;
        string $p1[] = `ls -long ($portalsPath + "|filler_exit_1")`;
        if (size($p0) > 0)
            swg_pob_fillerMoveToWorldPos($p0[0], $portalsPath, $cx, $y0, $zn);
        if (size($p1) > 0)
        {
            swg_pob_fillerMoveToWorldPos($p1[0], $portalsPath, $cx, $y0, $zp);
            xform -os -r 0 180 0 $p1[0];
        }
    }

    select -r $base;
    print ("// swg_pob_fillerFitPortalsFromRoomMesh: placed " + $numExits + " portal(s) from exterior bbox\n");
}

/// Selection: exterior filler mesh(es). Creates POB, assigns Tree paths, duplicates geo under r0|mesh, fits portals.
global proc swg_pob_fillerFromExteriorSelection(string $rootName, string $meshAppearPath, string $floorAppearPath, int $numExits,
                                                 float $doorW, float $doorH, int $addLights)
{
    if (`pluginInfo -q -loaded SwgMayaEditor` != 1)
        loadPlugin SwgMayaEditor;

    string $sel[] = `ls -sl -typ transform`;
    if (size($sel) < 1)
    {
        warning "swg_pob_fillerFromExteriorSelection: select the exterior transform(s) first";
        return;
    }
    if (size($meshAppearPath) < 1)
    {
        warning "swg_pob_fillerFromExteriorSelection: meshAppearPath (Tree path, no ext) required";
        return;
    }
    if ($numExits != 1 && $numExits != 2) return;

    if ($addLights != 0)
    {
        if (!`objExists swg_pob_sun`)
        {
            directionalLight -n swg_pob_sun -rgb 1 0.98 0.95 -intensity 1.15;
            rotate -r -os -35 45 0 swg_pob_sun;
            move 30 80 40 swg_pob_sun;
        }
        if (!`objExists swg_pob_fill`)
            ambientLight -n swg_pob_fill -rgb 0.45 0.48 0.55 -intensity 0.35;
    }

    if (size($rootName) < 1)
        $rootName = "pob_filler";

    eval ("createPobTemplate -n " + $rootName + " -cells 1");
    string $rootLong[] = `ls -long $rootName`;
    if (size($rootLong) < 1) return;
    string $base = $rootLong[0];

    swg_pob_fillerSetRefs($base, $meshAppearPath, $floorAppearPath);
    swg_pob_fillerParentSelectionUnderMesh($rootName);
    swg_pob_fillerFitPortalsFromRoomMesh($rootName, $numExits, $doorW, $doorH);

    print ("// swg_pob_fillerFromExteriorSelection: next — tune portals, validatePob, exportPob -i \".../" + $rootName + ".pob\"\n");
}
