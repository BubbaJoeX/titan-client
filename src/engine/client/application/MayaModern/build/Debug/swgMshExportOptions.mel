// SwgMsh (.msh / .apt) — Export Selection + File Import share this dialog (same translator).
// Options string: legacyTriangleFlip=0|1; objExportDirectUv=0|1; visualHardpoints=0|1
// (defaults 1;1;0 — visualHardpoints OFF stores hardpoints on swgSkmgHardpoints only; ON creates hp_* + polyCube helpers.)

global proc int swgMshExportOptions(string $parent, string $action, string $initialSettings, string $resultCallback)
{
    if ($action == "post")
    {
        setParent $parent;
        columnLayout -adj true swgMshExportOptCol;
        checkBox
            -label "Game viewer winding (triangle swap vs Maya getTriangles)"
            -annotation "ON (default): engine winding fix for Maya getTriangles. Works with Viewport UV: both ON = Maya viewport matches game Viewer. For odd OBJ meshes, use swgExportTriangleSwap on the shadingEngine (swgStaticMeshExport.mel) instead of unchecking both."
            -v 1
            swgMshLegacyTriFlipCheck;
        checkBox
            -label "Viewport UV (direct engine/Maya V)"
            -annotation "ON (default): Export writes Maya UV V as in viewport; paired with winding logic so Viewer matches Maya. OFF: use 1-V in .msh (legacy round-trip). Keep defaults ON for normal authoring."
            -v 1
            swgMshObjExportDirectUvCheck;
        checkBox
            -label "Viewport hardpoint cubes (legacy hp_* helpers)"
            -annotation "OFF (default): hardpoints only on swgSkmgHardpoints (no cubes). ON: create hp_* transforms with small cubes on import."
            -v 0
            swgMshVisualHardpointsCheck;

        if (size($initialSettings) > 0)
        {
            string $optionList[];
            tokenize($initialSettings, ";", $optionList);
            int $i;
            for ($i = 0; $i < size($optionList); $i++)
            {
                string $parts[];
                tokenize($optionList[$i], "=", $parts);
                if (size($parts) >= 2 && $parts[0] == "legacyTriangleFlip")
                {
                    if ($parts[1] == "1")
                        checkBox -e -v 1 swgMshLegacyTriFlipCheck;
                    else
                        checkBox -e -v 0 swgMshLegacyTriFlipCheck;
                }
                if (size($parts) >= 2 && $parts[0] == "objExportDirectUv")
                {
                    if ($parts[1] == "1")
                        checkBox -e -v 1 swgMshObjExportDirectUvCheck;
                    else
                        checkBox -e -v 0 swgMshObjExportDirectUvCheck;
                }
                if (size($parts) >= 2 && $parts[0] == "visualHardpoints")
                {
                    if ($parts[1] == "1")
                        checkBox -e -v 1 swgMshVisualHardpointsCheck;
                    else
                        checkBox -e -v 0 swgMshVisualHardpointsCheck;
                }
            }
        }
        return 1;
    }
    else if ($action == "query")
    {
        int $lt = `checkBox -q -v swgMshLegacyTriFlipCheck`;
        int $ouv = `checkBox -q -v swgMshObjExportDirectUvCheck`;
        int $vh = `checkBox -q -v swgMshVisualHardpointsCheck`;
        string $opt = ("legacyTriangleFlip=" + $lt + ";objExportDirectUv=" + $ouv + ";visualHardpoints=" + $vh);
        eval($resultCallback + " \"" + $opt + "\"");
        return 1;
    }
    return 0;
}
